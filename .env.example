# Copy only the settings you need into your private .env. Never commit real keys.
# The application reads this file only with --agent-env-file .env.
# Existing --runtime-file remains authoritative for PostgreSQL/Neo4j.
# Do not copy a different DATABASE_URL over the saved runtime settings.

# fake: local Fake provider, no paid model request. disabled: deterministic reads.
# Keep fake until the user recharges and explicitly resumes live verification.
# live requires verified available credits, prior spend, pricing and allowed input.
ONTO_MODEL_MODE=fake
ONTO_MODEL=openai/gpt-6.1-sol
ONTO_OPENROUTER_API_KEY=
ONTO_OPENAI_API_KEY=

# DEC-H29 explicitly approves a NEW $10 scope for this work. Previous spending
# remains separate/unknown. Existing DB budget rows cannot be reset on restart.
# Fixed limits: $10 in this scope, whole question $0.50, retry at most once.
ONTO_MODEL_BUDGET_ID=mks2-agent-20261108
ONTO_MODEL_BUDGET_AUTHORIZATION=DEC-H29
ONTO_MODEL_PRIOR_SPEND_USD=0

# Existing local Langfuse project; metadata only. No raw questions/BOM/gold/secrets.
ONTO_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:53000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Reserved for the separately verified comparison exporter. SDK auto tracing is
# intentionally not enabled, because it could capture private workflow state.
ONTO_LANGSMITH_API_KEY=
